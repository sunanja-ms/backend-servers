{
  "name": "fastify-backend-2026",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-ready Fastify backend with Drizzle ORM",
  "main": "dist/server.js",
  "scripts": {
    "start:all": "node scripts/run.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "NODE_ENV=test node --import tsx --test test/routes.test.ts",
    "test:load": "node test/load-test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "transcode": "node src/scripts/transcode.mjs"
  },
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/compress": "^9.1.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.0.0",
    "bcryptjs": "^3.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.7.2",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.30.0",
    "nodemailer": "^9.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2"
  }
}
